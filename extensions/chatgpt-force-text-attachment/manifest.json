{
  "manifest_version": 3,
  "name": "ChatGPT Clipboard Attachment",
  "version": "1.0.0",
  "description": "Attach clipboard text to ChatGPT as a text file with one click; clipboard read only after click.",
  "permissions": [
    "clipboardRead"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-clipboard@firefox-scripts.example"
    }
  }
}

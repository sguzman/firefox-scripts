    {
      "id": "scribd-downloader",
      "site": "scribd.com",
      "title": "Scribd Downloader",
      "summary": "Legacy Scribd reader/download helper; compatibility and authorization require review.",
      "hosts": [
        "*.scribd.com"
      ],
      "source": "https://github.com/sguzman/script-monkey/blob/main/userscripts/scribd.com/scribd-downloader/scribd-downloader.user.js",

    {
      "id": "page-snapshot",
      "site": "web",
      "title": "Page Snapshot ZIP",
      "summary": "Manually archive rendered page HTML and retrievable client-side assets into a local ZIP with an incomplete-resource manifest.",
      "hosts": [
        "*"
      ],
      "source": "https://github.com/sguzman/firefox-scripts/blob/main/userscripts/web/page-snapshot/page-snapshot.user.js",
      "origin": "native",
      "scope": "all-pages-manual",
      "status": "rebuilt",
      "allowedGrants": [
        "GM_registerMenuCommand",
        "GM_xmlhttpRequest"
      ],
      "connectHosts": [
        "*"

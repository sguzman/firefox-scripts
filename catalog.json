{
  "schemaVersion": 1,
  "sourceRepository": "https://github.com/sguzman/script-monkey",
  "scope": "Five selected Firefox migrations and one new manually launched Page Snapshot ZIP; remaining legacy scripts are candidates. No automatic installation.",
  "scripts": [
    {
      "id": "chatgpt-copy-entire-chat",
      "site": "chatgpt.com",
      "title": "ChatGPT Copy Entire Chat",
      "summary": "Export the complete current conversation to the clipboard, including paginated API retrieval and fallback.",
      "hosts": [
        "chatgpt.com",
        "www.chatgpt.com"
      ],
      "source": "https://github.com/sguzman/script-monkey/blob/main/userscripts/chatgpt.com/chatgpt-copy-entire-chat/chatgpt-copy-entire-chat.user.js",
      "status": "rebuilt",
      "allowedGrants": [
        "GM_setClipboard",
        "GM_registerMenuCommand"
      ]
    },
    {
      "id": "chatgpt-current-message-jump",
      "site": "chatgpt.com",
      "title": "ChatGPT Current Message Jump",
      "summary": "Display unobtrusive navigation arrows for long ChatGPT responses.",
      "hosts": [
        "chatgpt.com",
        "www.chatgpt.com"
      ],
      "source": "https://github.com/sguzman/script-monkey/blob/main/userscripts/chatgpt.com/chatgpt-current-message-jump/chatgpt-current-message-jump.user.js",
      "status": "rebuilt",
      "allowedGrants": [
        "none"
      ]
    },
    {
      "id": "chatgpt-force-text-attachment",
      "site": "chatgpt.com",
      "title": "ChatGPT Force Text Attachment",
      "summary": "Attach clipboard plain text to a ChatGPT prompt as a .txt file.",
      "hosts": [
        "chatgpt.com",
        "www.chatgpt.com"
      ],
      "source": "https://github.com/sguzman/script-monkey/blob/main/userscripts/chatgpt.com/chatgpt-force-text-attachment/chatgpt-force-text-attachment.user.js",
      "status": "rebuilt",
      "allowedGrants": [
        "none"
      ]
    },
    {
      "id": "chatgpt-sticky-copy",
      "site": "chatgpt.com",
      "title": "ChatGPT Sticky Copy",
      "summary": "Keep an accessible Copy control available for long code and writing blocks.",
      "hosts": [
        "chatgpt.com",
        "www.chatgpt.com"
      ],
      "source": "https://github.com/sguzman/script-monkey/blob/main/userscripts/chatgpt.com/chatgpt-sticky-copy/chatgpt-sticky-copy.user.js",
      "status": "rebuilt",
      "allowedGrants": [
        "GM_setClipboard"
      ]
    },
    {
      "id": "github-file-copy",
      "site": "github.com",
      "title": "GitHub File Row Copy",
      "summary": "Copy file contents directly from a GitHub repository listing.",
      "hosts": [
        "github.com"
      ],
      "source": "https://github.com/sguzman/script-monkey/blob/main/userscripts/github.com/github-file-copy/github-file-copy.user.js",
      "status": "rebuilt",
      "allowedGrants": [
        "GM_setClipboard",
        "GM_xmlhttpRequest"
      ],
      "connectHosts": [
        "github.com",
        "raw.githubusercontent.com"
      ]
    },
    {
      "id": "youtube-play-all",
      "site": "youtube.com",
      "title": "YouTube Play All",
      "summary": "Construct and reuse a private channel playlist with video, Shorts, and live-feed ordering.",
      "hosts": [
        "www.youtube.com"
      ],
      "source": "https://github.com/sguzman/script-monkey/blob/main/userscripts/youtube.com/youtube-play-all/youtube-play-all.user.js",

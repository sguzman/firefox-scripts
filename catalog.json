      "hosts": [
        "backloggd.com"
      ],
      "source": "https://github.com/sguzman/script-monkey/blob/main/userscripts/backloggd.com/backloggd-export/backloggd-export.user.js",
      "status": "candidate"
    },
    {
      "id": "libgen-filter",
